[Unit]
Description=Domain Guard
After=network.target

[Service]
Type=simple
User=domain-guard
Group=domain-guard
WorkingDirectory=/opt/domain-guard/app
EnvironmentFile=/opt/domain-guard/app/.env.vps
ExecStart=/opt/domain-guard/app/.venv/bin/python -m waitress --host=0.0.0.0 --port=5000 wsgi:app
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/domain-guard/data

[Install]
WantedBy=multi-user.target
