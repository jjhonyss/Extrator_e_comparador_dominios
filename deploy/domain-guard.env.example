DOMAIN_GUARD_HOST=0.0.0.0
DOMAIN_GUARD_PORT=5000
DOMAIN_GUARD_DATA_DIR=/opt/domain-guard/data
DOMAIN_GUARD_BASE_FILE_PATH=/opt/domain-guard/data/base/base_atual.txt
DOMAIN_GUARD_REJECTED_FILE_PATH=/opt/domain-guard/data/base/base_rejeitados.txt
DOMAIN_GUARD_TARGET_CORRECTIONS_PATH=/opt/domain-guard/data/base/correcoes_manuais.txt
DOMAIN_GUARD_UPLOAD_DIR=/opt/domain-guard/data/uploads
DOMAIN_GUARD_OUTPUT_DIR=/opt/domain-guard/data/output
DOMAIN_GUARD_RUNS_DIR=/opt/domain-guard/data/output/runs
DOMAIN_GUARD_AUDIT_DIR=/opt/domain-guard/data/audits
DOMAIN_GUARD_LOG_DIR=/opt/domain-guard/data/logs
DOMAIN_GUARD_BACKUP_DIR=/opt/domain-guard/data/backups
DOMAIN_GUARD_MAX_FILE_SIZE=524288000
DOMAIN_GUARD_ENABLE_OCR=true
DOMAIN_GUARD_OCR_ONLY_IF_NO_DOMAINS=true
DOMAIN_GUARD_OCR_LANGUAGE=por+eng
DOMAIN_GUARD_RETENTION_RUN_DAYS=30
DOMAIN_GUARD_RETENTION_UPLOAD_DAYS=14
DOMAIN_GUARD_RETENTION_BACKUP_DAYS=90
DOMAIN_GUARD_RETENTION_UPDATED_BASE_DAYS=30
